{
  "name": "avalon-topology-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Developer-facing visualizer for the Avalon network: walks nodes from a seed through the protocol SDK and draws a latency-embedded graph. A read-only client.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "dependencies": {
    "@avalon-initiative/common-ui": "0.1.3",
    "@avalon-initiative/protocol-sdk": "0.1.5",
    "d3-force": "3.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "sass": "^1.104.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
